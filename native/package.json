{
  "name": "changuito-native",
  "private": true,
  "version": "2.0.0",
  "description": "Native Changuito app for the Solana dApp Store. Wallet sign-in only.",
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild -p android",
    "build:apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleRelease",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter spec src/auth/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@solana/kit": "^8.4.0",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "expo": "~58.0.20",
    "expo-build-properties": "~58.0.0",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.0",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  }
}
