{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js", "polyfill.js", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["android", "ios", "node_modules"]
}
